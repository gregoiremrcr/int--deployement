{
  "name": "int-deployement",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "ci": "npm run lint && npm run check:locales && npm run format:check && npm run typecheck && npm run typecheck:backend && npm run lint:backend && npm run format:check:backend && npm test && npm run test:backend && npm run build:backend && npm run test:e2e && npm run build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:backend": "prettier --check backend tests/backend.test.ts tsconfig.backend.json",
    "preview": "nuxt preview",
    "api": "tsx backend/index.ts",
    "test": "vitest run tests/wishlist.test.ts tests/pokeapi.test.ts tests/backend.test.ts",
    "test:backend": "vitest run tests/backend.test.ts",
    "test:integration": "vitest run tests/integration/supabase.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "test:api": "vitest run tests/backend.test.ts",
    "test:e2e": "playwright test",
    "build:backend": "tsc -p tsconfig.backend.json --outDir dist/backend",
    "lint:backend": "eslint backend tests/backend.test.ts",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@hono/aws-lambda": "^1.0.1",
    "@hono/node-server": "^2.1.6",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "hono": "^4.13.16",
    "nuxt": "^4.6.3",
    "tsx": "^4.23.15",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "crossws": "0.4.17"
  }
}
